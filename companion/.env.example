# --- Required ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=            # from @BotFather
# Comma-separated Telegram user IDs allowed to talk to the bot.
# Leave empty: the first person to send /start becomes the owner (saved in the DB).
ALLOWED_USER_IDS=

# --- Brain (Claude). Optional: without it the bot still sends the daily protocol
# and saves your replies, but answers with short canned acknowledgements.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low              # low | medium | high  (chat replies don't need more)

# --- Voice out (text-to-speech) ---------------------------------------------
# fish        = Fish Audio (default): natural voices, huge voice library, voice cloning
# edge        = free Microsoft neural voices, no key (automatic fallback)
# elevenlabs  = top quality, most expensive
# openai      = cheap and good
TTS_PROVIDER=fish
FISH_API_KEY=                  # fish.audio -> API keys
FISH_VOICE_ID=                 # id from a voice URL (fish.audio/m/<id>) or from `python -m companion.clone_voice`
FISH_MODEL=s2.1-pro
FISH_LATENCY=normal            # normal = best quality, balanced = faster
FISH_SPEED=1.0                 # 0.5 - 2.0
EDGE_VOICE=en-US-AndrewNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Voice in (transcribe your voice replies) --------------------------------
# none | groq (cheapest) | openai
STT_PROVIDER=none
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# --- Defaults for new users (each user can change with /settings commands) ----
DEFAULT_TZ=Europe/Berlin
DEFAULT_WAKE=07:00
DEFAULT_BED=23:00
DEFAULT_TRAINING_DAYS=mon,wed,fri

# --- Storage ------------------------------------------------------------------
DATA_DIR=./data

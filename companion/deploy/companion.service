# systemd unit for running without Docker.
# Install: sudo cp deploy/companion.service /etc/systemd/system/ && sudo systemctl enable --now companion
[Unit]
Description=Huberman daily companion (Telegram bot)
After=network-online.target
Wants=network-online.target

[Service]
User=companion
WorkingDirectory=/opt/companion
EnvironmentFile=/opt/companion/.env
ExecStart=/opt/companion/.venv/bin/python -m companion
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
